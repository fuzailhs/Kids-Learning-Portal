# Server port
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:3000

# Required in production. Used to hash the anonymous session id before storage.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_HASH_SALT=replace-with-a-long-random-value

# PostgreSQL connection string. Leave empty for the local embedded PostgreSQL
# (PGlite) used by `npm run dev`.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kids_portal
# Set to "true" only when your hosted Postgres requires TLS.
PGSSL=false

# Where the embedded local database stores its files.
PGLITE_DATA_DIR=.data/pglite

# AI provider adapter: "stub" for offline development, "openai" for a real model.
# If AI_API_KEY is present and AI_PROVIDER is unset, the openai adapter is used.
AI_PROVIDER=stub
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional. Enables GET /api/facilitator/export (Bearer token, server-side only).
FACILITATOR_TOKEN=
